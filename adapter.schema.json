{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "e-Cidade Nextcloud adapter contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "tested",
    "min_php",
    "upstream",
    "hooks",
    "capabilities",
    "gaps",
    "production_ready",
    "certification"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,40}$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "version": {
      "type": "string",
      "minLength": 3
    },
    "tested": {
      "type": "boolean"
    },
    "min_php": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "upstream": {
      "type": "string",
      "minLength": 4
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "source",
              "target",
              "replacement",
              "contract"
            ],
            "properties": {
              "type": {
                "const": "php-file-override"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "git_blob"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_/-]+\\.php$"
                  },
                  "git_blob": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  }
                }
              },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_/-]+\\.php$"
              },
              "replacement": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_/-]+\\.php$"
              },
              "contract": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "source"
            ],
            "properties": {
              "type": {
                "const": "source-signature"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "git_blob"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_/-]+\\.php$"
                  },
                  "git_blob": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "script"
            ],
            "properties": {
              "type": {
                "const": "php-bootstrap"
              },
              "script": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_/-]+\\.php$"
              }
            }
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planned_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "production_ready": {
      "type": "boolean"
    },
    "certification": {
      "type": "string",
      "minLength": 3
    },
    "storage_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "usage",
          "spi",
          "operations"
        ],
        "properties": {
          "surface": {
            "type": "string",
            "enum": [
              "large-object-facade",
              "direct-pg-lo",
              "e-storage",
              "laravel-storage",
              "filesystem",
              "bytea",
              "temporary",
              "cache",
              "export"
            ]
          },
          "usage": {
            "type": "string",
            "enum": [
              "persistent-document",
              "temporary",
              "cache",
              "export",
              "unsupported"
            ]
          },
          "spi": {
            "const": 1
          },
          "operations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "reserve",
                "create",
                "read",
                "update",
                "delete",
                "inspect"
              ]
            }
          }
        }
      }
    }
  }
}
